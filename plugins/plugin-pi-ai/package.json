{
  "name": "@elizaos/plugin-pi-ai",
  "version": "2.0.3-beta.7",
  "description": "Opt-in elizaOS text-provider gateway foundation backed by Pi AI.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "engines": {
    "node": ">=22.19.0"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./catalog": {
      "types": "./dist/catalog/index.d.ts",
      "import": "./dist/catalog/index.js",
      "default": "./dist/catalog/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@earendil-works/pi-ai": "0.84.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@elizaos/core": "workspace:*",
    "@types/bun": "1.3.14",
    "@types/node": "25.6.2",
    "@typescript/typescript6": "^6.0.2",
    "bun-types": "1.3.14",
    "typescript": "^6.0.3",
    "vitest": "^4.0.17"
  },
  "peerDependencies": {
    "@elizaos/core": "workspace:*"
  },
  "scripts": {
    "build": "bun run build.ts",
    "clean": "node ../../packages/scripts/rm-path-recursive.mjs dist .turbo",
    "format": "bunx @biomejs/biome format --write .",
    "format:check": "bunx @biomejs/biome format .",
    "lint": "bunx @biomejs/biome check --write --unsafe .",
    "lint:check": "bunx @biomejs/biome check .",
    "test": "vitest run --config ./vitest.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.api-compat.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "eliza": {
    "platforms": [
      "node"
    ],
    "runtime": "node"
  }
}
